{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core APIs, HTTP to local model runtimes, cloud providers and web search, and opening links in the browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
