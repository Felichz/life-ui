{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LifeUI",
  "version": "0.3.0",
  "identifier": "app.lifeui.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LifeUI",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A local AI harness for organizing your life",
    "publisher": "Felix Andersson",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "longDescription": "LifeUI is a local AI harness for your life: a personal assistant and coach that runs on a model on your own machine. It plans with you, puts every session on your calendar only after your yes, and remembers what you told it.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQzU0QUYxRDYwNDUzQkMKUldTOFV3VFc4VXJGc3RJSHV6Qmt0ZGMwdnl1NUlyeDNPek5EMkRlVUNSR0JaR0sxNVFwa1NxUWQK",
      "endpoints": ["https://github.com/Felichz/life-ui/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
