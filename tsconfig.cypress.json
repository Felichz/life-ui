{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "cypress-real-events", "@4tw/cypress-drag-drop"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "isolatedModules": false,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["cypress/**/*.ts"]
} 