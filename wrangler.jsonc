// LifeUI on Cloudflare Workers (static assets). Production: lifeui.medanolabs.com
// The landing page at /, the web app under /app/ (scripts/build-site.mjs builds both into dist-site/).
// Deploy from this machine: `npm run deploy` (or `npm run deploy:staging`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeui",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "lifeui.medanolabs.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "lifeui-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "lifeui-stg.medanolabs.com", "custom_domain": true }]
    }
  }
}
