// LifeUI on Cloudflare Workers (static assets). Production: lifeui.medanolabs.com
// Deploy from this machine: `npm run deploy` (or `npm run deploy:staging`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeui",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "lifeui.medanolabs.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "lifeui-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "lifeui-stg.medanolabs.com", "custom_domain": true }]
    }
  }
}
