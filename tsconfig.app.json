{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@shadcn": ["./src/ui/components/shadcn"],
      "@shadcn/*": ["./src/ui/components/shadcn/*"]
    },
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["src"]
}
